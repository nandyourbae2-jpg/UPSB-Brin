# Salin menjadi .env.local untuk pengembangan lokal. JANGAN commit berkas .env.local.
# Semua variabel divalidasi di src/env.ts.

# URL publik situs (metadata, sitemap, Open Graph). Contoh produksi: https://domain-upsb.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gerbang konten botani. "staging" menampilkan konten verified:false dengan label "perlu verifikasi".
# "production" hanya menampilkan konten verified:true. Produksi Vercel WAJIB "production".
CONTENT_ENV=staging

# Nomor WhatsApp resmi UPSB format internasional tanpa tanda +, mis. 6281234567890.
# Kosongkan jika belum ditetapkan pemilik produk (tampilan akan menandai menunggu nomor resmi).
SITE_WHATSAPP_NUMBER=

# Pengaturan sementara sebelum SiteSetting di database (M4): tampilkan harga indikatif ("true" | "false")
SHOW_INDICATIVE_PRICES=true

# Mulai M4 (belum dipakai di M0):
# DATABASE_URL=
# DIRECT_URL=
# AUTH_SECRET=
# BLOB_READ_WRITE_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
